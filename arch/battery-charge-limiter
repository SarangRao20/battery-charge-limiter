#!/usr/bin/env python3

import os
import time
import subprocess
import sys

ACPI_CALL_PATH = "/proc/acpi/call"
BATTERY_PATH = "/sys/class/power_supply/BAT0"

START_THRESHOLD = 75
STOP_THRESHOLD = 80
POLL_INTERVAL = 60

WMI_INHIBIT = r"\_SB.WMID.SBCO BUFQ{0x00, 0x05, 0x00, 0x00}"
WMI_AUTO = r"\_SB.WMID.SBCC BUFQ{0x00, 0x00, 0x00, 0x00}"


def read_battery_pct():
    try:
        with open(os.path.join(BATTERY_PATH, "capacity")) as f:
            return int(f.read().strip())
    except Exception:
        return None


def read_battery_status():
    try:
        with open(os.path.join(BATTERY_PATH, "status")) as f:
            return f.read().strip()
    except Exception:
        return "Unknown"


def acpi_call(method):
    try:
        result = subprocess.run(
            ["tee", ACPI_CALL_PATH],
            input=method.encode(),
            capture_output=True,
            check=True
        )
        with open(ACPI_CALL_PATH, "r") as f:
            return f.read().strip()
    except Exception as e:
        return f"ERROR: {e}"


def set_charge_mode(inhibit):
    method = WMI_INHIBIT if inhibit else WMI_AUTO
    result = acpi_call(method)
    return "ERROR" not in result


def main():
    if os.geteuid() != 0:
        print("Must run as root", file=sys.stderr)
        sys.exit(1)

    if not os.path.exists(ACPI_CALL_PATH):
        print("acpi_call module not loaded. Run: modprobe acpi_call", file=sys.stderr)
        sys.exit(1)

    print(f"Battery charge limiter started: {START_THRESHOLD}%-{STOP_THRESHOLD}%", flush=True)
    inhibited = False

    while True:
        pct = read_battery_pct()
        status = read_battery_status()

        if pct is None:
            time.sleep(POLL_INTERVAL)
            continue

        on_ac = status in ("Charging", "Full", "Not charging")

        if on_ac and not inhibited and pct >= STOP_THRESHOLD:
            print(f"Battery {pct}% >= {STOP_THRESHOLD}% - inhibiting charge", flush=True)
            if set_charge_mode(True):
                inhibited = True
            else:
                print("Failed to inhibit charge", flush=True)

        elif inhibited and pct <= START_THRESHOLD:
            print(f"Battery {pct}% <= {START_THRESHOLD}% - resuming auto charge", flush=True)
            if set_charge_mode(False):
                inhibited = False
            else:
                print("Failed to resume charge", flush=True)

        time.sleep(POLL_INTERVAL)


if __name__ == "__main__":
    main()
